# Copy values into GitHub → Settings → Secrets and variables → Actions
# Do NOT commit real values (never commit fastlane/.env).

FASTLANE_USER=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=
TEAM_ID=
BUNDLE_ID=com.rejuvenation.yoka
SCHEME=Yoka
APP_NAME=Yoka
EXPORT_METHOD=app-store
MATCH_PASSWORD=
# Required on CI: base64 of "GITHUB_USERNAME:PERSONAL_ACCESS_TOKEN"
# Generate: echo -n 'muyifeiyangcc:ghp_xxx' | base64
# Same MATCH_* / ASC_* / TEAM_ID / FASTLANE_USER as Cubixa is OK (shared certs repo).
MATCH_GIT_BASIC_AUTHORIZATION=
