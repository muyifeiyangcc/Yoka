# Fastlane → match → gym → TestFlight (GetMac CI)
# Adapted from Cubixa; certs repo shared via Matchfile.

default_platform(:ios)

username = ENV["FASTLANE_USER"]
asc_key_id = ENV["ASC_KEY_ID"]
asc_issuer_id = ENV["ASC_ISSUER_ID"]
asc_key_content = ENV["ASC_KEY_CONTENT"]

team_id = ENV["TEAM_ID"]
scheme = ENV["SCHEME"]
bundle_id = ENV["BUNDLE_ID"]
app_name = ENV["APP_NAME"]
export_method = ENV["EXPORT_METHOD"]

platform :ios do

  before_all do |lane, options|
    UI.header "Step: before_all"
    UI.important "username = #{username}"
    UI.important "asc_key_id = #{asc_key_id}"
    UI.important "asc_issuer_id = #{asc_issuer_id}"
    UI.important "asc_key_content set = #{!asc_key_content.to_s.strip.empty?}"
    UI.important "bundle_id = #{bundle_id}"
    UI.important "app_name = #{app_name}"
    UI.important "export_method = #{export_method}"
    UI.important "is_ci = #{is_ci}"
    setup_ci if is_ci
  end

  private_lane :load_asc_api_key do
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    raw_key = ENV["ASC_KEY_CONTENT"].to_s.strip
    # Support: PEM, literal \n, or base64(.p8)
    key_content = raw_key.gsub("\\n", "\n")
    is_base64 = !key_content.include?("BEGIN") && !key_content.empty?

    api_key_args = {
      key_id: key_id,
      issuer_id: issuer_id,
      in_house: false,
      duration: 1200
    }
    if !key_content.empty?
      api_key_args[:key_content] = key_content
      api_key_args[:is_key_content_base64] = is_base64
    else
      api_key_args[:key_filepath] = "AuthKey_#{key_id}.p8"
    end
    app_store_connect_api_key(api_key_args)
  end

  lane :release do
    api_key = load_asc_api_key
    on_match
    prepare_gym

    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_number,
      xcodeproj: "Yoka.xcodeproj"
    )

    gym(
      project: "Yoka.xcodeproj",
      scheme: ENV["SCHEME"],
      clean: true,
      export_method: export_method,
      output_directory: "./build",
      output_name: "Yoka.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/Yoka.ipa",
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  lane :on_match do
    api_key = load_asc_api_key

    # setup_ci forces MATCH_READONLY=true; override unless FORCE_MATCH_READONLY=true
    force_readonly = ENV["FORCE_MATCH_READONLY"].to_s.strip.downcase == "true"
    ENV["MATCH_READONLY"] = force_readonly ? "true" : "false"
    match_type = (export_method || "app-store").gsub("-", "")

    if is_ci && !force_readonly
      sh("git config --global user.email 'ci@yoka.local'")
      sh("git config --global user.name 'Yoka CI'")
    end

    match_result = match(
      api_key: api_key,
      git_branch: username,
      username: username,
      team_id: ENV["TEAM_ID"].to_s.strip.empty? ? nil : ENV["TEAM_ID"].to_s.strip,
      type: match_type,
      app_identifier: [bundle_id],
      readonly: force_readonly,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
    )
    UI.important("✅ match_result: #{match_result}")
    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    UI.important("profiles = #{profiles}")
  end

  lane :prepare_gym do
    resolved_team = ENV["sigh_#{bundle_id}_appstore_team-id"] || ENV["TEAM_ID"].to_s.strip
    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"] || "match AppStore #{bundle_id}"
    UI.important("Team ID: #{resolved_team}")
    UI.important("profile_name = #{profile_name}")

    update_code_signing_settings(
      path: "Yoka.xcodeproj",
      use_automatic_signing: false,
      team_id: resolved_team,
      targets: ["Yoka"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: bundle_id,
    )
  end

end
